{
  "name": "luna-library",
  "version": "0.5.0",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "build-storybook": "pnpm --filter docs build-storybook",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "storybook": "pnpm --filter docs storybook",
    "release:check": "pnpm lint && pnpm check-types && pnpm test && pnpm build && pnpm build-storybook"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.10.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
