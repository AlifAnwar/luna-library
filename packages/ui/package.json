{
  "name": "@withalif/luna",
  "version": "0.5.0",
  "description": "Internal React design system for accessible enterprise applications",
  "private": true,
  "type": "module",
  "keywords": [
    "design-system",
    "react",
    "typescript",
    "ui-components"
  ],
  "homepage": "https://github.com/AlifAnwar/luna-library#readme",
  "bugs": {
    "url": "https://github.com/AlifAnwar/luna-library/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AlifAnwar/luna-library.git",
    "directory": "packages/ui"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && pnpm run validate:dist",
    "clean": "node scripts/clean-dist.mjs",
    "dev": "tsdown --watch",
    "lint": "eslint . --max-warnings 0",
    "generate:component": "turbo gen react-component",
    "generate:icons": "node scripts/generate-icons.mjs",
    "check-types": "tsc --noEmit",
    "validate:dist": "publint run . --pack false --strict",
    "pack:check": "pnpm run build && node scripts/package-smoke-test.mjs --inspect-only",
    "size:report": "pnpm run build && node scripts/package-size-report.mjs",
    "size:check": "pnpm run build && node scripts/package-size-report.mjs --check",
    "test:package": "pnpm run clean && pnpm run build && node scripts/package-smoke-test.mjs"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@material-symbols/svg-400": "^0.47.4",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@svgr/core": "^8.1.0",
    "@svgr/plugin-jsx": "^8.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tsdown/css": "0.23.2",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "eslint": "10.9.1",
    "postcss": "^8.5.28",
    "postcss-import": "17.0.1",
    "publint": "0.3.25",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "tsdown": "0.23.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "7.0.2"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@daypicker/react": "^10.0.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "recharts": "3.10.1"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  }
}
