{
  "name": "docs",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev --port 3001",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings 0",
    "check-types": "next typegen && tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "test:phase6c:browser": "vitest run --config vitest.phase6c.config.ts",
    "test:phase6c:narrow": "vitest run --config vitest.phase6c.narrow.config.ts",
    "test:phase6c:preferences": "vitest run --config vitest.phase6c.preferences.config.ts",
    "test:phase6c:fixture": "pnpm --filter @withalif/luna run build && node scripts/phase6c-compatibility-fixture.mjs"
  },
  "dependencies": {
    "@withalif/luna": "workspace:*",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "5.3.1",
    "@hugeicons/core-free-icons": "^4.3.3",
    "@hugeicons/react": "^1.1.10",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/nextjs-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser-playwright": "5.0.1",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.9.1",
    "eslint-plugin-storybook": "^10.6.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.28",
    "storybook": "^10.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
